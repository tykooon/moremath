@inherits LayoutComponentBase
@layout MainLayout

@inject IJSRuntime JsRuntime

<HeadContent>
    <MathJaxScripts />
</HeadContent>

@Body

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            await JsRuntime.InvokeVoidAsync("MathJax.typesetPromise");
        }
    }
}
