@inherits LayoutComponentBase
@inject NavigationManager NavigationManager


    <Header />

    <main class="container">
        <div class="right-sidebar-grid">
            <div class="main-page">
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <ErrorBlock Message="@context.Message" />
                    </ErrorContent>
                </ErrorBoundary>
            </div>
            <SectionOutlet SectionName="main-sidebar"/>
        </div>
    </main>


    <Footer />

