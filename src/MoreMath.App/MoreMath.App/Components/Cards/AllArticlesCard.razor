@inject NavigationManager NavManager

<div class="article-card@(IsSidebar? " sidebar-card" : "")" style="background-color: transparent;">
    <div class="article-card__body" @onclick=@(() => NavManager.NavigateTo("/articles/search"))>
        <div class="article-card__image">
            <img src="assets/images/svg/search-glass.svg" alt="banner" />
        </div>
        <div class="article-card__title">
            <h3>Показать больше...</h3>
        </div>
        <div class="article-card__abstract">
            <p>перейти на страницу поиску по статьям.</p>
        </div>
    </div>
    <div class="article-card__footer">
        <span></span>
    </div>
</div>

@code{
    [Parameter]
    public bool IsSidebar { get; set; }
}