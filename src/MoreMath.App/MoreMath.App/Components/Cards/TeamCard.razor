@using MoreMath.Dto.Dtos
@inject NavigationManager _navigationManager
@rendermode InteractiveServer


<div class="team-card mm-card">
    <div class="mm-card__body">
        <a class="team-card__person" href="about/@Author.SlugName">
            <div class="team-card__person__photo">
                <img src="@($"{Constants.BLOB_STORAGE}/authors/{Author.SlugName}.png")" alt=@Author.SlugName />
            </div>
            <div class="team-card__person__name">
                <p>
                    @($"{Author.FirstName} {Author.LastName}")
                </p>
            </div>
        </a>
        <div class="team-card__info">
            @Author.Info
        </div>
    </div>

</div>

@code {
    [Parameter]
    public AuthorDto Author { get; set; } = default!;
}
