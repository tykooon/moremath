@using MoreMath.Application.UseCases.Articles.Queries
@using MoreMath.Dto.Responses
@using MoreMath.Dto.Dtos
@using System.Globalization

@inject NavigationManager NavManager

<div class="article-card@(IsSidebar? " sidebar-card" : "")">
    <div class="article-card__body" @onclick="@(() => NavManager.NavigateTo("/articles/"+ArticleDto?.Slug, forceLoad: true))">
        <div class="article-card__image">
            <img src="@(Constants.BLOB_STORAGE+"/articles/banners/"+ArticleDto?.ImageUri)" alt="banner" />
        </div>
        <div class="article-card__title">
            <h3>@ArticleDto?.Title</h3>
        </div>
        <div class="article-card__abstract">
            <p>@ArticleDto?.Abstract</p>
        </div>
    </div>
    <div class="article-card__footer">
        <span>
            @(ArticleDto?.Created.ToString("dd MMMM yyyy", new CultureInfo("ru-Ru")))
        </span>
    </div>
</div>

@code {
    [Parameter]
    public ArticlePageItem ArticleDto { get; set; } = default!;

    [Parameter]
    public bool IsSidebar { get; set; }
}
