@if (IsParagraph)
{
    <div class="hebrew-block">
        @ChildContent
    </div>
}
else
{
    <span class="hebrew-text">@ChildContent</span>
}

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; } = null!;

    [Parameter]
    public bool IsParagraph { get; set; } = false;
}
