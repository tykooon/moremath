@using MoreMath.Application.Contracts.Services
@using MoreMath.Application.UseCases.Articles.Queries
@using MoreMath.Dto.Responses

@inject IArticleService ArticleService

<div class="article-rack@(IsSidebar? " fluid-rack" : "")">
        @foreach (var art in _articles)
        {
            <ArticleCard ArticleDto="@art" IsSidebar="@IsSidebar"/>
        }
    <AllArticlesCard IsSidebar="@IsSidebar" />
</div>




@code {
    private IEnumerable<ArticlePageItem> _articles = [];

    [Parameter]
    public string? CategoryName { get; set; }

    [Parameter]
    public int[]? AuthorsId { get; set; }

    [Parameter]
    public IEnumerable<string>? TagNames { get; set; }

    [Parameter]
    public bool IsSidebar { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _articles = await ArticleService.GetArticlesPagedAsync(
            title: null,
            categoryName: CategoryName,
            tags: TagNames?.ToArray(),
            hasAllTags: true,
            authorsId: AuthorsId,
            hasAllAuthors: true,
            orderBy: "created",
            descending: true,
            start: 0,
            take: 6);
    }
}
