    </div>
    <EditForm Model="Input" autocomplete="off" method="post" OnValidSubmit="LoginUser" FormName="login" class="mm-form mm-acc-form">
        <DataAnnotationsValidator />
        <div class="mm-form__row">
            <div class="mm-form__field">
                <InputText @bind-Value="Input.Email" autocomplete="off" placeholder="" id="login-email" class="mm-form__field__input" />
                <input type="password" autocomplete="new-password" name="fuck-the-edge" style="display:none">
                <label for="login-email" class="mm-form__field__label">E-mail</label>
                <ValidationMessage For="() => Input.Email" class="validation-message" />
            </div>
        </div>
        <div class="mm-form__row">
            <div class="mm-form__field">
                <InputText type="password" placeholder="" autocomplete="off" id="login-password" @bind-Value="Input.Password" class="mm-form__field__input" />
                <label for="login-password" class="mm-form__field__label">Пароль</label>
